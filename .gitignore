# Go
/bin/
*.exe
*.test
*.out
vendor/

# Compiled plugin binaries.
#
# `go build ./extension-example/notes` with no -o writes ./notes, and four of
# those — 18MB each — reached the repository through a `git add -A`. Named
# explicitly rather than by a pattern: the names collide with nothing, and a
# rule broad enough to catch any extensionless executable would also catch
# files somebody meant to commit.
/notes
/ratelimit
/audit
/inventory
/apikey
/echoplugin
/orphanhost
/moduless
/core-bin

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Java
target/
*.class

# Node
node_modules/
dist/

# Env / secrets
.env
.env.local

# OS / IDE
.DS_Store
.idea/
.vscode/

# Air hot-reload artifacts
/tmp/
/air.log

# Plugin packages built into the runtime directory
/plugins/
